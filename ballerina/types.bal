# The Standalone 3DS API allows you to run EMV 3D Secure (3DS) authentication using Stripe while authorizing the payment with any PSP.
# 
# Related guide: [Standalone 3DS](/payments/3d-secure/standalone-3d-secure)
public type ThreeDSecureAuthentication record {
    # The 3DS directory server with which this 3DS Authentication was processed
    @jsondata:Name {value: "directory_server"}
    "american_express"|"cartes_bancaires"|"discover"|"mastercard"|"visa" directoryServer;
    # The reason for invoking this 3DS Authentication
    "cardholder_authentication"|"issuer_requested"|"liability_shift"|"processing_costs"|"regulatory_compliance" reason?;
    # The amount for this 3DS Authentication
    int amount?;
    # Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format
    record {|string...;|}? metadata?;
    # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`
    boolean livemode;
    # Time at which the object was created. Measured in seconds since the Unix epoch
    int created;
    # Contains additional details about the acquirer for a 3DS Authentication
    @jsondata:Name {value: "acquirer_details"}
    ThreeDSecureStandaloneResourceAcquirerDetails acquirerDetails?;
    # Contains details on the channel used (browser, 3RI) for a standalone 3DS Authentication
    ThreeDSecureStandaloneResourceChannel channel;
    # Indicates whether this 3DS Authentication is being performed for a payment or non-payment use case
    @jsondata:Name {value: "message_category"}
    "non_payment_authentication"|"payment_authentication" messageCategory;
    # The URL for presenting a challenge to your cardholder, present if status is requires_challenge
    @jsondata:Name {value: "challenge_url"}
    string challengeUrl?;
    # Contains details of the flow preference used for a standalone 3DS Authentication
    @jsondata:Name {value: "flow_preference"}
    ThreeDSecureStandaloneResourceFlowPreference flowPreference?;
    # Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies)
    string currency?;
    # The URL for performing issuer fingerprinting, present if fingerprinting is supported for the given payment method
    @jsondata:Name {value: "fingerprinting_url"}
    string fingerprintingUrl?;
    # Unique identifier for the object
    @constraint:String {maxLength: 5000}
    string id;
    # Contains details about the shipping address for a 3DS Authentication
    @jsondata:Name {value: "shipping_address"}
    ThreeDSecureStandaloneResourceShippingAddress shippingAddress?;
    # Contains information about the future authorisations related to this authentication
    @jsondata:Name {value: "future_usage"}
    ThreeDSecureStandaloneResourceFutureUsage futureUsage?;
    # Contains details on the result for a standalone 3DS Authentication
    @jsondata:Name {value: "outcome_details"}
    ThreeDSecureStandaloneResourceOutcomeDetails outcomeDetails?;
    # The outcome of this 3DS Authentication
    "abandoned"|"attempt_acknowledged"|"authenticated"|"canceled"|"denied"|"informational"|"internal_error"|"not_supported"|"not_triggered"|"processing_error"|"rejected" outcome?;
    # ID of the payment method (a PaymentMethod object) to attach to this 3DS Authentication
    @jsondata:Name {value: "payment_method"}
    string|PaymentMethod paymentMethod;
    # String representing the object's type. Objects of the same type share the same value
    "three_d_secure.authentication" 'object;
    # Status of this Authentication
    "canceled"|"error"|"failed"|"requires_challenge"|"requires_submission"|"succeeded" status;
};

