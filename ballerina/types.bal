# This hash contains the features the mobile payment element supports
public type CustomerSessionResourceComponentsResourceMobilePaymentElementResourceFeatures record {
    # Controls whether or not the mobile payment element shows saved payment methods
    @jsondata:Name {value: "payment_method_redisplay"}
    "disabled"|"enabled"? paymentMethodRedisplay?;
