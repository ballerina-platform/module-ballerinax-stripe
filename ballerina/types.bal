    # The outbound transfers of the feature access.
    @jsondata:Name {value: "outbound_transfers"}
    OutboundTransfers outboundTransfers?;
    # The deposit insurance of the feature access.
    @jsondata:Name {value: "deposit_insurance"}
    Access depositInsurance?;
    # The inbound transfers of the feature access.
    @jsondata:Name {value: "inbound_transfers"}
    InboundTransfers inboundTransfers?;
    # The financial addresses of the feature access.
