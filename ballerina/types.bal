# A Payment Attempt Record represents an individual attempt at making a payment, on or off Stripe.
# Each payment attempt tries to collect a fixed amount of money from a fixed customer and payment
# method. Payment Attempt Records are attached to Payment Records. Only one attempt per Payment Record
# can have guaranteed funds
public type PaymentAttemptRecord record {
    # A representation of an amount of money, consisting of an amount and a currency
    PaymentsPrimitivesPaymentRecordsResourceAmount amount;
    # Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format
    record {|string...;|} metadata;
    # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`
    boolean livemode;
    # Time at which the object was created. Measured in seconds since the Unix epoch
    int created;
    # Indicates whether the customer was present in your checkout flow during this payment
    @jsondata:Name {value: "customer_presence"}
    "off_session"|"on_session"? customerPresence?;
    # Information about the Payment Method debited for this payment
    @jsondata:Name {value: "payment_method_details"}
    PaymentsPrimitivesPaymentRecordsResourcePaymentMethodDetails? paymentMethodDetails?;
    # Shipping information for this payment
    @jsondata:Name {value: "shipping_details"}
    PaymentsPrimitivesPaymentRecordsResourceShippingDetails? shippingDetails?;
    # An arbitrary string attached to the object. Often useful for displaying to users
    string? description?;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_canceled"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountCanceled;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_authorized"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountAuthorized;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_refunded"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountRefunded;
    # ID of the Payment Record this Payment Attempt Record belongs to
    @jsondata:Name {value: "payment_record"}
    string? paymentRecord?;
    # Customer information for this payment
    @jsondata:Name {value: "customer_details"}
    PaymentsPrimitivesPaymentRecordsResourceCustomerDetails? customerDetails?;
    # ID of the Connect application that created the PaymentAttemptRecord
    string? application?;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_requested"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountRequested;
    # Processor information associated with this payment
    @jsondata:Name {value: "processor_details"}
    PaymentsPrimitivesPaymentRecordsResourceProcessorDetails processorDetails;
    # Indicates who reported the payment
    @jsondata:Name {value: "reported_by"}
    "self"|"stripe" reportedBy;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_guaranteed"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountGuaranteed;
    # Unique identifier for the object
    @constraint:String {maxLength: 5000}
    string id;
    # A representation of an amount of money, consisting of an amount and a currency
    @jsondata:Name {value: "amount_failed"}
    PaymentsPrimitivesPaymentRecordsResourceAmount amountFailed;
    # String representing the object's type. Objects of the same type share the same value
    "payment_attempt_record" 'object;
};

