    PaymentMethodUsBankAccount usBankAccount?;
    # The customer balance of the payment method.
    @jsondata:Name {value: "customer_balance"}
    PaymentMethodCustomerBalance customerBalance?;
    # The cashapp of the payment method.
    PaymentMethodCashapp cashapp?;
    # Unique identifier for the object
    @constraint:String {maxLength: 5000}
    string id;
    # The pix of the payment method.
    PaymentMethodPix pix?;
    # The revolut pay of the payment method.
    @jsondata:Name {value: "revolut_pay"}
    PaymentMethodRevolutPay revolutPay?;
    # The sunbit of the payment method.
    PaymentMethodSunbit sunbit?;
    # The zip of the payment method.
    PaymentMethodZip zip?;
    # The customer account of the payment method.
    @jsondata:Name {value: "customer_account"}
    string? customerAccount?;
    # The ideal of the payment method.
    PaymentMethodIdeal ideal?;
    # The sequra of the payment method.
    PaymentMethodSequra sequra?;
    # Time at which the object was created. Measured in seconds since the Unix epoch
    int created;
    # The eps of the payment method.
    PaymentMethodEps eps?;
    # The konbini of the payment method.
    PaymentMethodKonbini konbini?;
    # The paypay of the payment method.
    PaymentMethodPaypay paypay?;
    # The sofort of the payment method.
    PaymentMethodSofort sofort?;
