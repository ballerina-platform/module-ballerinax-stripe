    # The naver pay of the payment method.
    @jsondata:Name {value: "naver_pay"}
    PaymentMethodNaverPay naverPay?;
    # The pay by bank of the payment method.
    @jsondata:Name {value: "pay_by_bank"}
    PaymentMethodPayByBank payByBank?;
    # The paypal of the payment method.
    PaymentMethodPaypal paypal?;
    # The giropay of the payment method.
    PaymentMethodGiropay giropay?;
    # The alipay of the payment method.
    PaymentFlowsPrivatePaymentMethodsAlipay alipay?;
    # The custom of the payment method.
