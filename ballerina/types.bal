# Evidence to upload, to respond to a dispute. Updating any field in the hash will submit all fields in the hash for review. The combined character count of all fields is limited to 150,000
public type DisputeEvidenceParams record {
    # The refund policy of the dispute evidence params.
    @jsondata:Name {value: "refund_policy"}
    string refundPolicy?;
    # The enhanced evidence of the dispute evidence params.
    @jsondata:Name {value: "enhanced_evidence"}
    record {record {boolean fee_acknowledged?;} mastercard_compliance?; record {record {string|"" customer_account_id?; string|"" customer_device_fingerprint?; string|"" customer_device_id?; string|"" customer_email_address?; string|"" customer_purchase_ip?; "merchandise"|"services" merchandise_or_services?; string|"" product_description?; record {string|"" city?; string|"" country?; string|"" line1?; string|"" line2?; string|"" postal_code?; string|"" state?;} shipping_address?;} disputed_transaction?; record {string charge; string|"" customer_account_id?; string|"" customer_device_fingerprint?; string|"" customer_device_id?; string|"" customer_email_address?; string|"" customer_purchase_ip?; string|"" product_description?; record {string|"" city?; string|"" country?; string|"" line1?; string|"" line2?; string|"" postal_code?; string|"" state?;} shipping_address?;}[] prior_undisputed_transactions?;} visa_compelling_evidence_3?; record {boolean fee_acknowledged?;} visa_compliance?;}|"" enhancedEvidence?;
    # The customer communication of the dispute evidence params.
    @jsondata:Name {value: "customer_communication"}
    string customerCommunication?;
    # The date on which a physical product began its route to the shipping address, in a clear human-readable format
    @jsondata:Name {value: "shipping_date"}
    string shippingDate?;
    # The billing address provided by the customer
    @jsondata:Name {value: "billing_address"}
    string billingAddress?;
    # The duplicate charge documentation of the dispute evidence params.
    @jsondata:Name {value: "duplicate_charge_documentation"}
    string duplicateChargeDocumentation?;
    # Documentation demonstrating that the customer was shown your refund policy prior to purchase
    @jsondata:Name {value: "refund_policy_disclosure"}
    string refundPolicyDisclosure?;
    # The delivery service that shipped a physical product, such as Fedex, UPS, USPS, etc. If multiple carriers were used for this purchase, please separate them with commas
    @jsondata:Name {value: "shipping_carrier"}
    string shippingCarrier?;
    # The service documentation of the dispute evidence params.
    @jsondata:Name {value: "service_documentation"}
    string serviceDocumentation?;
    # Any additional evidence or statements
    @jsondata:Name {value: "uncategorized_text"}
    string uncategorizedText?;
    # An explanation of how and when the customer was shown your refund policy prior to purchase
    @jsondata:Name {value: "cancellation_policy_disclosure"}
    string cancellationPolicyDisclosure?;
