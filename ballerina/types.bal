    @jsondata:Name {value: "allowed_card_presences"}
    ("not_present"|"present")[]? allowedCardPresences?;
};

# Options to configure Radar. See [Radar Session](https://docs.stripe.com/radar/radar-session) for more information
public type RadarRadarOptions record {
    # A [Radar Session](https://docs.stripe.com/radar/radar-session) is a snapshot of the browser metadata and device details that help Radar make more accurate predictions on your payments
    @constraint:String {maxLength: 5000}
    string session?;
};

public type MerchantPostalAddress record {
    # The country of the merchant postal address.
    @constraint:String {maxLength: 5000}
    string country;
    # The city of the merchant postal address.
    string|"" city?;
    # The state of the merchant postal address.
    string|"" state?;
    # The postal code of the merchant postal address.
    @jsondata:Name {value: "postal_code"}
    string|"" postalCode?;
    # The line2 of the merchant postal address.
    string|"" line2?;
    # The line1 of the merchant postal address.
    string|"" line1?;
};

@constraint:String {maxLength: 5000}
public type ReportPaymentAttemptInformationalRequestExpandItemsString string;

@constraint:String {maxLength: 5000}
public type UpdateSavedQueryRequestExpandItemsString string;

public type PaypalSellerProtection record {
    # An array of conditions that are covered for the transaction, if applicable
    @jsondata:Name {value: "dispute_categories"}
    ("fraudulent"|"product_not_received")[]? disputeCategories?;
    # Indicates whether the transaction is eligible for PayPal's seller protection
    "eligible"|"not_eligible"|"partially_eligible" status;
};

public type BillingMeterResourceBillingMeterValue record {
    # The key in the meter event payload to use as the value for this meter
    @jsondata:Name {value: "event_payload_key"}
    string eventPayloadKey;
};

public type IssuingCardsListFeaturesParam record {
    # Whether to allow card spend dispute management features
    @jsondata:Name {value: "card_spend_dispute_management"}
    boolean cardSpendDisputeManagement?;
    # Whether to allow card management features
    @jsondata:Name {value: "card_management"}
    boolean cardManagement?;
    # Whether to allow cardholder management features
    @jsondata:Name {value: "cardholder_management"}
    boolean cardholderManagement?;
    # The disable stripe user authentication of the issuing cards list features param.
    @jsondata:Name {value: "disable_stripe_user_authentication"}
    boolean disableStripeUserAuthentication?;
    # Whether to allow spend control management features
    @jsondata:Name {value: "spend_control_management"}
    boolean spendControlManagement?;
};

# A Configurations object represents how features should be configured for terminal readers.
# For information about how to use it, see the [Terminal configurations documentation](https://docs.stripe.com/terminal/fleet/configurations-overview)
public type TerminalConfiguration record {
    # The bbpos wisepad3 of the terminal configuration.
    @jsondata:Name {value: "bbpos_wisepad3"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig bbposWisepad3?;
    # Whether this Configuration is the default for your account
    @jsondata:Name {value: "is_account_default"}
    boolean? isAccountDefault?;
    # The wifi of the terminal configuration.
    TerminalConfigurationConfigurationResourceWifiConfig wifi?;
    # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`
    boolean livemode;
    # The verifone ux700 of the terminal configuration.
    @jsondata:Name {value: "verifone_ux700"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig verifoneUx700?;
    # The bbpos wisepos e of the terminal configuration.
    @jsondata:Name {value: "bbpos_wisepos_e"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig bbposWiseposE?;
    # The reboot window of the terminal configuration.
    @jsondata:Name {value: "reboot_window"}
    TerminalConfigurationConfigurationResourceRebootWindow rebootWindow?;
    # The stripe s700 of the terminal configuration.
    @jsondata:Name {value: "stripe_s700"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig stripeS700?;
    # The stripe s710 of the terminal configuration.
    @jsondata:Name {value: "stripe_s710"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig stripeS710?;
    # The verifone m425 of the terminal configuration.
    @jsondata:Name {value: "verifone_m425"}
    TerminalConfigurationConfigurationResourceDeviceTypeSpecificConfig verifoneM425?;
    # The offline of the terminal configuration.
    TerminalConfigurationConfigurationResourceOfflineConfig offline?;
    # The verifone p630 of the terminal configuration.
    @jsondata:Name {value: "verifone_p630"}
