# Payment Evaluations represent the risk lifecycle of an externally processed payment. It includes the Radar risk score from Stripe, payment outcome taken by the merchant or processor, and any post transaction events, such as refunds or disputes. See the [Radar API guide](/radar/multiprocessor) for integration steps
public type RadarPaymentEvaluation record {
    # Client device metadata attached to this payment evaluation
    @jsondata:Name {value: "client_device_metadata_details"}
    InsightsResourcesPaymentEvaluationClientDeviceMetadata clientDeviceMetadataDetails?;
    # Customer details attached to this payment evaluation
    @jsondata:Name {value: "customer_details"}
    InsightsResourcesPaymentEvaluationCustomerDetails customerDetails?;
    # Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format
    record {|string...;|}? metadata?;
    # Collection of signals for this payment evaluation
    InsightsResourcesPaymentEvaluationSignals signals;
    # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`
    boolean livemode;
    # Payment details attached to this payment evaluation
    @jsondata:Name {value: "payment_details"}
    InsightsResourcesPaymentEvaluationPaymentDetails paymentDetails?;
    # Recommended action based on the score of the `fraudulent_payment` signal. Possible values are `block`, `continue` and `request_three_d_secure`
    @jsondata:Name {value: "recommended_action"}
    "block"|"continue" recommendedAction;
    # Time at which the object was created. Measured in seconds since the Unix epoch
    @jsondata:Name {value: "created_at"}
    int createdAt;
    # Unique identifier for the object
