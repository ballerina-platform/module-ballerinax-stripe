# A credit grant is an API resource that documents the allocation of some billing credits to a customer.
# 
# Related guide: [Billing credits](https://docs.stripe.com/billing/subscriptions/usage-based/billing-credits)
public type BillingCreditGrant record {
    # ID of the account representing the customer receiving the billing credits
    @jsondata:Name {value: "customer_account"}
    string? customerAccount?;
    # The time when this credit grant was voided. If not present, the credit grant hasn't been voided
    @jsondata:Name {value: "voided_at"}
    int? voidedAt?;
    # The amount of the billing credit grant.
    BillingCreditGrantsResourceAmount amount;
    # Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format
    record {|string...;|} metadata;
    # ID of the test clock this credit grant belongs to
    @jsondata:Name {value: "test_clock"}
    string|TestHelpersTestClock? testClock?;
    # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`
    boolean livemode;
    # Time at which the object was created. Measured in seconds since the Unix epoch
    int created;
    # The priority for applying this credit grant. The highest priority is 0 and the lowest is 100
    int? priority?;
    # The applicability config of the billing credit grant.
    @jsondata:Name {value: "applicability_config"}
    BillingCreditGrantsResourceApplicabilityConfig applicabilityConfig;
    # The time when the billing credits become effective-when they're eligible for use
    @jsondata:Name {value: "effective_at"}
    int? effectiveAt?;
    # The time when the billing credits expire. If not present, the billing credits don't expire
    @jsondata:Name {value: "expires_at"}
    int? expiresAt?;
    # A descriptive name shown in dashboard
    string? name?;
    # Unique identifier for the object
    @constraint:String {maxLength: 5000}
    string id;
    # The category of this credit grant. This is for tracking purposes and isn't displayed to the customer
    "paid"|"promotional" category;
    # Time at which the object was last updated. Measured in seconds since the Unix epoch
    int updated;
    # ID of the customer receiving the billing credits
    string|Customer|DeletedCustomer customer;
    # String representing the object's type. Objects of the same type share the same value
    "billing.credit_grant" 'object;
};

